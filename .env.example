# Application
ENVIRONMENT=development
DEBUG=true
API_SECRET_KEY=generate-a-strong-secret-here

# Database — for local dev, SQLite is used by default
# For Docker/prod, use PostgreSQL:
DATABASE_URL=postgresql://dental:dental@localhost:5432/dental_db

# VAPI Configuration
# Get these from https://dashboard.vapi.ai
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-phone-number-id
VAPI_ASSISTANT_ID=your-assistant-id
VAPI_WEBHOOK_SECRET=your-webhook-secret

# Clinic Configuration
CLINIC_NAME=Bright Smile Dental Clinic
CLINIC_PHONE=+1-800-DENTIST
CLINIC_TIMEZONE=America/New_York
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
APPOINTMENT_SLOT_MINUTES=30
MAX_ADVANCE_BOOKING_DAYS=60

# Escalation
HUMAN_ESCALATION_PHONE=+1XXXXXXXXXX

# Monitoring (optional)
SENTRY_DSN=
